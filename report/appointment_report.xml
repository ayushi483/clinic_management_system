<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- APPOINTMENT REPORT TEMPLATE -->

        <template id="appointment_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.internal_layout">

                        <div class="page">

                            <h1 style="text-align:center;">Appointment Report</h1>

                            <!-- PATIENT INFORMATION -->

                            <h3 style="margin-top:20px;">Patient Information</h3>

                            <table style="width:100%; border:1px solid black; border-collapse:collapse; margin-top:10px;">
                                <thead>
                                    <tr style="background-color:#e6e6e6;">
                                        <th style="border:1px solid black; padding:8px;">Patient Name</th>
                                        <th style="border:1px solid black; padding:8px;">Doctor</th>
                                        <th style="border:1px solid black; padding:8px;">Appointment Time</th>
                                        <th style="border:1px solid black; padding:8px;">Doctor Fees</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border:1px solid black; padding:8px;">
                                            <t t-esc="o.patient_id.name"/>
                                        </td>
                                        <td style="border:1px solid black; padding:8px;">
                                            <t t-esc="o.doctor_id.name"/>
                                        </td>
                                        <td style="border:1px solid black; padding:8px;">
                                            <t t-esc="o.appointment_datetime"/>
                                        </td>
                                        <td style="border:1px solid black; padding:8px;">
                                            <t t-esc="o.doctor_fees"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- FOOTER MESSAGE -->

                            <div style="margin-top:40px; text-align:center; font-size:14px;">
                                <p>Thank you for reviewing the appointment report.</p>
                            </div>

                        </div>

                    </t>
                </t>
            </t>
        </template>

        <!-- PAPER FORMAT -->

        <record id="paper_format_appointment" model="report.paperformat">
            <field name="name">Appointment Report Paper</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
        </record>

        <!-- REPORT ACTION -->

        <report
                id="action_appointment_report"
                model="clinic.appointment"
                string="Appointment Report"
                report_type="qweb-pdf"
                name="clinic_managment.appointment_report_template"
                file="clinic_managment.appointment_report_template"
                paperformat="clinic_managment.paper_format_appointment"
        />

    </data>
</odoo>