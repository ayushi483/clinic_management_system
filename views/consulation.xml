<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_consultation_list" model="ir.ui.view">
            <field name="name">clinic.consultation.list</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="appointment_id"/>
                    <field name="diagnosis"/>
                </list>
            </field>
        </record>

        <record id="view_consultation_form" model="ir.ui.view">
            <field name="name">clinic.consultation.form</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <form string="Consultation">
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="draft,confirmed,cancel"/>

                        <button name="action_consultation_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'draft'"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="patient_id" readonly="1"/>
                            <field name="doctor_id" readonly="1"/>
                            <field name="appointment_id" readonly="1"/>
                            <field name="date"/>
                        </group>

                        <group>
                            <field name="symptoms"/>
                            <field name="diagnosis"/>
                            <field name="note"/>
                        </group>
                        <notebook>
                            <page string="Prescription">
                                <field name="prescription_ids">
                                    <list editable="bottom">
                                        <field name="medicine_id"/>
                                        <field name="dosage"/>
                                        <field name="duration"/>
                                        <field name="frequency"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_consultation_kanban" model="ir.ui.view">
            <field name="name">clinic.consultation.kanban</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="date"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <strong>
                                    <field name="patient_id"/>
                                </strong>
                                <br/>
                                <span>Doctor:
                                    <field name="doctor_id"/>
                                </span>
                                <br/>
                                <span>
                                    <field name="date"/>
                                </span>
                                <br/>
                                <span>
                                    <field name="diagnosis"/>
                                </span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_consultation_calendar" model="ir.ui.view">
            <field name="name">clinic.consultation.calendar</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <calendar string="Consultations"
                          date_start="date"
                          color="doctor_id">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                </calendar>
            </field>
        </record>


        <record id="view_consultation_graph" model="ir.ui.view">
            <field name="name">clinic.consultation.graph</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <graph string="Consultation Graph" type="bar">
                    <field name="doctor_id"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_clinic_consultation_search" model="ir.ui.view">
            <field name="name">clinic.consultation.search</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>

                    <separator/>

                    <!-- Group By -->
                    <group>
                        <filter name="group_by_symptoms"
                                string="Symptoms"
                                context="{'group_by':'symptoms'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_diagnosis"
                                string="Diagnosis"
                                context="{'group_by':'diagnosis'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_date"
                                string="Date"
                                context="{'group_by':'date'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_note"
                                string="Note"
                                context="{'group_by':'note'}"/>
                    </group>

                </search>
            </field>
        </record>

        <record id="view_clinic_consultation_pivot" model="ir.ui.view">
            <field name="name">clinic.consultation.pivot</field>
            <field name="model">clinic.consultation</field>
            <field name="arch" type="xml">
                <pivot string="Consultation Analysis">
                    <field name="patient_id" type="row"/>
                    <field name="doctor_id" type="row"/>
                    <field name="appointment_id" type="row"/>
                    <field name="symptoms" type="col"/>
                </pivot>
            </field>
        </record>


        <record id="action_consultation" model="ir.actions.act_window">
            <field name="name">Consultations</field>
            <field name="res_model">clinic.consultation</field>
            <field name="view_mode">list,form,kanban,pivot,calendar,graph</field>
        </record>


    </data>
</odoo>