<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appointment_line_list" model="ir.ui.view">
        <field name="name">appointment.line.list</field>
        <field name="model">appointment.line</field>
        <field name="arch" type="xml">
            <list string="Appointment Report">
                <field name="patient_name"/>
                <field name="patient_age"/>
                <field name="phone_number"/>
                <field name="email"/>
                <field name="doctor_name"/>
                <field name="doctor_phone"/>
                <field name="doctor_email"/>
                <field name="doctor_fees"/>
                <field name="specialty_of_doctor"/>
                <field name="appointment_code"/>
                <field name="appointment_datetime"/>
                <field name="notes"/>
                <field name="status"/>
                <field name="total_payment"/>
            </list>
        </field>
    </record>

</odoo>