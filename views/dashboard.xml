<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_clinic_dashboard_kanban" model="ir.ui.view">
            <field name="name">clinic.dashboard.kanban</field>
            <field name="model">clinic.dashboard</field>
            <field name="arch" type="xml">
                <kanban create="false" edit="false" delete="false"
                        class="o_clinic_dashboard_kanban">

                    <field name="total_patients"/>
                    <field name="todays_appointments"/>
                    <field name="total_doctors"/>
                    <field name="confirmed_appointments"/>
                    <field name="cancelled_appointments"/>
                    <field name="no_show_appointments"/>

                    <t t-name="card">
                        <style>
                            .o_clinic_dashboard_kanban .o_kanban_renderer,
                            .o_clinic_dashboard_kanban .o_kanban_group,
                            .o_clinic_dashboard_kanban .o_kanban_column {
                                width: 100% !important;
                                max-width: 100% !important;
                                padding: 0 !important;
                                margin: 0 !important;
                                background: transparent !important;
                                box-shadow: none !important;
                                border: none !important;
                            }
                            .o_clinic_dashboard_kanban .o_kanban_record {
                                width: 100% !important;
                                max-width: 100% !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                background: transparent !important;
                                box-shadow: none !important;
                                border: none !important;
                                border-radius: 0 !important;
                            }
                            .o_clinic_dashboard_kanban .o_kanban_record:hover {
                                box-shadow: none !important;
                            }
                            .dash-stat-card:hover {
                                filter: brightness(1.08);
                                transform: translateY(-2px);
                                transition: all 0.2s ease;
                            }
                            .dash-link {
                                display: flex;
                                align-items: center;
                                gap: 16px;
                                width: 100%;
                                height: 100%;
                                padding: 20px;
                                box-sizing: border-box;
                                text-decoration: none;
                                cursor: pointer;
                            }
                            .dash-link-sm {
                                display: flex;
                                align-items: center;
                                gap: 14px;
                                width: 100%;
                                height: 100%;
                                padding: 18px;
                                box-sizing: border-box;
                                text-decoration: none;
                                cursor: pointer;
                            }
                        </style>

                        <!-- DASHBOARD WRAPPER -->
                        <div style="width:100%; box-sizing:border-box; padding:24px; background:#f0f2f5;">

                            <!-- ROW 1: Top stat cards -->
                            <div style="display:flex; flex-direction:row; gap:20px; margin-bottom:20px; width:100%; box-sizing:border-box;">

                                <!-- Total Patients -->
                                <div class="dash-stat-card" style="flex:1 1 0; min-height:160px; background-color:#e53935; border-radius:14px; transition: all 0.2s ease;">
                                    <a type="object" name="action_open_patients" class="dash-link" style="min-height:160px;">
                                        <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:68px; height:68px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                            <span class="fa fa-users" title="Total Patients" style="font-size:28px; color:#fff;"/>
                                        </div>
                                        <div style="text-align:left;">
                                            <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Total Patients</div>
                                            <div style="font-size:44px; color:#fff; font-weight:700; line-height:1;">
                                                <t t-esc="record.total_patients.value or 0"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Today's Appointments -->
                                <div class="dash-stat-card" style="flex:1 1 0; min-height:160px; background-color:#1e88e5; border-radius:14px; transition: all 0.2s ease;">
                                    <a type="object" name="action_open_todays" class="dash-link" style="min-height:160px;">
                                        <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:68px; height:68px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                            <span class="fa fa-calendar-check-o" title="Today's Appointments" style="font-size:28px; color:#fff;"/>
                                        </div>
                                        <div style="text-align:left;">
                                            <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Today's Appointments</div>
                                            <div style="font-size:44px; color:#fff; font-weight:700; line-height:1;">
                                                <t t-esc="record.todays_appointments.value or 0"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Total Doctors -->
                                <div class="dash-stat-card" style="flex:1 1 0; min-height:160px; background-color:#f4511e; border-radius:14px; transition: all 0.2s ease;">
                                    <a type="object" name="action_open_doctors" class="dash-link" style="min-height:160px;">
                                        <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:68px; height:68px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                            <span class="fa fa-user-md" title="Total Doctors" style="font-size:28px; color:#fff;"/>
                                        </div>
                                        <div style="text-align:left;">
                                            <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Total Doctors</div>
                                            <div style="font-size:44px; color:#fff; font-weight:700; line-height:1;">
                                                <t t-esc="record.total_doctors.value or 0"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Doctor-wise Appointments -->
                                <div class="dash-stat-card" style="flex:1 1 0; min-height:160px; background-color:#2e7d32; border-radius:14px; transition: all 0.2s ease;">
                                    <a type="object" name="action_open_doctor_wise" class="dash-link" style="min-height:160px;">
                                        <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:68px; height:68px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                            <span class="fa fa-pie-chart" title="Doctor-wise Appointments" style="font-size:28px; color:#fff;"/>
                                        </div>
                                        <div style="text-align:left;">
                                            <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Doctor-wise</div>
                                            <div style="font-size:22px; color:#fff; font-weight:700; line-height:1.2;">Appointments</div>
                                        </div>
                                    </a>
                                </div>

                            </div>

                            <!-- ROW 2: Appointment Status -->
                            <div style="background-color:#6a1b9a; border-radius:16px; padding:28px; width:100%; box-sizing:border-box;">

                                <div style="color:#fff; font-size:17px; font-weight:700; margin-bottom:18px; text-align:center; letter-spacing:0.3px;">
                                    Appointment Status
                                </div>

                                <div style="display:flex; flex-direction:row; gap:20px; width:100%; box-sizing:border-box;">

                                    <!-- Confirmed -->
                                    <div class="dash-stat-card" style="flex:1 1 0; min-height:150px; background-color:#43a047; border-radius:12px; transition: all 0.2s ease;">
                                        <a type="object" name="action_open_confirmed" class="dash-link-sm" style="min-height:150px;">
                                            <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:62px; height:62px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                                <span class="fa fa-check-circle" title="Confirmed" style="font-size:26px; color:#fff;"/>
                                            </div>
                                            <div style="text-align:left;">
                                                <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Confirmed</div>
                                                <div style="font-size:38px; color:#fff; font-weight:700; line-height:1;">
                                                    <t t-esc="record.confirmed_appointments.value or 0"/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                    <!-- Cancelled -->
                                    <div class="dash-stat-card" style="flex:1 1 0; min-height:150px; background-color:#e53935; border-radius:12px; transition: all 0.2s ease;">
                                        <a type="object" name="action_open_cancelled" class="dash-link-sm" style="min-height:150px;">
                                            <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:62px; height:62px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                                <span class="fa fa-times-circle" title="Cancelled" style="font-size:26px; color:#fff;"/>
                                            </div>
                                            <div style="text-align:left;">
                                                <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">Cancelled</div>
                                                <div style="font-size:38px; color:#fff; font-weight:700; line-height:1;">
                                                    <t t-esc="record.cancelled_appointments.value or 0"/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                    <!-- No Show -->
                                    <div class="dash-stat-card" style="flex:1 1 0; min-height:150px; background-color:#f57c00; border-radius:12px; transition: all 0.2s ease;">
                                        <a type="object" name="action_open_no_show" class="dash-link-sm" style="min-height:150px;">
                                            <div style="background:rgba(255,255,255,0.25); border-radius:50%; width:62px; height:62px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                                                <span class="fa fa-exclamation-circle" title="No Show" style="font-size:26px; color:#fff;"/>
                                            </div>
                                            <div style="text-align:left;">
                                                <div style="font-size:15px; color:rgba(255,255,255,0.9); margin-bottom:4px;">No Show</div>
                                                <div style="font-size:38px; color:#fff; font-weight:700; line-height:1;">
                                                    <t t-esc="record.no_show_appointments.value or 0"/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </t>
                </kanban>
            </field>
        </record>

        <record id="action_clinic_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">clinic.dashboard</field>
            <field name="view_mode">kanban</field>
            <field name="target">current</field>
            <field name="limit">1</field>
        </record>

        <record id="clinic_dashboard_record" model="clinic.dashboard">
            <field name="name">Dashboard</field>
            <field name="total_patients">0</field>
            <field name="todays_appointments">0</field>
            <field name="total_doctors">0</field>
            <field name="confirmed_appointments">0</field>
            <field name="cancelled_appointments">0</field>
            <field name="no_show_appointments">0</field>
        </record>

    </data>
</odoo>