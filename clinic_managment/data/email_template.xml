<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email Template: Appointment Confirmed -->
        <record id="email_template_appointment_confirmed" model="mail.template">
            <field name="name">Clinic: Appointment Confirmed</field>
            <field name="model_id" ref="clinic_managment.model_clinic_appointment"/>
            <field name="email_from">{{ (object.doctor_id.email or object.company_id.email or '') }}</field>
            <field name="email_to">{{ object.patient_email }}</field>
            <field name="subject">Appointment Confirmed - {{ object.appointment_code }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 14px;">
                    <p>Dear <strong>{{ object.patient_id.name }}</strong>,</p>

                    <p>We are pleased to confirm your appointment. Please find the details below:</p>

                    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5; width: 200px;">
                                <strong>Appointment Code</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.appointment_code }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5;">
                                <strong>Doctor</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.doctor_id.name }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5;">
                                <strong>Speciality</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.doctor_speciality.name or 'N/A' }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5;">
                                <strong>Date &amp; Time</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.appointment_datetime }}
                            </td>
                        </tr>
                    </table>

                    <p>Please arrive <strong>15 minutes</strong> before your scheduled time.</p>
                    <p>If you need to reschedule or cancel, please contact us at the earliest.</p>

                    <br/>
                    <p>Best Regards,</p>
                    <p><strong>{{ object.doctor_id.name }}</strong></p>
                    <p style="color: #888;">Clinic Management</p>
                </div>
            </field>
        </record>

        <!-- Email Template: Appointment Cancelled -->
        <record id="email_template_appointment_cancelled" model="mail.template">
            <field name="name">Clinic: Appointment Cancelled</field>
            <field name="model_id" ref="clinic_managment.model_clinic_appointment"/>
            <field name="email_from">{{ (object.doctor_id.email or object.company_id.email or '') }}</field>
            <field name="email_to">{{ object.patient_email }}</field>
            <field name="subject">Appointment Cancelled - {{ object.appointment_code }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 14px;">
                    <p>Dear <strong>{{ object.patient_id.name }}</strong>,</p>

                    <p>We regret to inform you that your appointment has been <strong style="color: #e74c3c;">cancelled</strong>. Below are the details:</p>

                    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5; width: 200px;">
                                <strong>Appointment Code</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.appointment_code }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5;">
                                <strong>Doctor</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.doctor_id.name }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; background-color: #f5f5f5;">
                                <strong>Scheduled Date &amp; Time</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.appointment_datetime }}
                            </td>
                        </tr>
                    </table>

                    <p>If you wish to reschedule your appointment, please contact us or book a new appointment through our system.</p>

                    <br/>
                    <p>We apologize for any inconvenience.</p>
                    <p>Best Regards,</p>
                    <p><strong>{{ object.doctor_id.name }}</strong></p>
                    <p style="color: #888;">Clinic Management</p>
                </div>
            </field>
        </record>

    </data>
</odoo>