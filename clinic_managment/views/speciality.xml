<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- FORM VIEW -->
        <record id="view_speciality_form" model="ir.ui.view">
            <field name="name">res.speciality.form</field>
            <field name="model">res.speciality</field>
            <field name="arch" type="xml">
                <form string="Speciality">
                    <sheet>
                        <div style="display: flex; align-items: center; justify-content: space-between;">

                            <field name="image" widget="image" class="oe_avatar" style="width: 100px; height: 100px;"/>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_speciality_list" model="ir.ui.view">
            <field name="name">res.speciality.list</field>
            <field name="model">res.speciality</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

          <record id="view_res_speciality_search" model="ir.ui.view">
            <field name="name">res.speciality.search</field>
            <field name="model">res.speciality</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>

                    <separator/>

                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="active" domain="[('active','=',False)]"/>

                    <separator/>
                    <group>
                        <filter name="group_by_name"
                                string="Name"
                                context="{'group_by':'name'}"/>
                    </group>
                </search>
            </field>
        </record>


        <!-- ACTION -->
        <record id="action_speciality" model="ir.actions.act_window">
            <field name="name">Specialities</field>
            <field name="res_model">res.speciality</field>
            <field name="view_mode">list,search,form</field>
        </record>
    </data>
</odoo>