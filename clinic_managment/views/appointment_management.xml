<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_appointment_form" model="ir.ui.view">
            <field name="name">clinic.appointment.form</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <form string="Appointment">
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="draft,confirmed,done,cancel,no_show"/>

                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'draft'"/>

                        <button name="action_create_invoice"
                                string="Create Invoice"
                                type="object"
                                class="btn-success"
                                invisible="status != 'confirmed'"/>

                        <button name="action_do_consultation"
                                string="Consultation"
                                type="object"
                                class="btn-info"
                                invisible="status != 'confirmed'"/>

                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn-danger"
                                invisible="status != 'confirmed'"/>

                        <button name="action_no_show"
                                string="No Show"
                                type="object"
                                class="btn-danger"
                                invisible="status != 'confirmed'"/>

                        <button name="action_report_appointment"
                                string="Create Report"
                                type="object"
                                class="btn-danger"
                                invisible="status != 'confirmed'"/>

                        <button name="action_download_appointment_excel"
                                string="Download in excel"
                                type="object"
                                class="btn-danger"
                                invisible="status != 'confirmed'"/>

                        <button name="action_reset_to_draft"
                                string="Reset to Draft"
                                type="object"
                                class="btn-info"
                                invisible="status != 'cancel'"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="appointment_code" readonly="1"/>
                            </h1>
                        </div>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoices"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-stethoscope">
                                <field name="invoice_count"
                                       widget="statinfo"
                                       string="Invoices"/>
                            </button>
                            <button name="action_view_consultation"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-stethoscope">
                                <field name="consultation_count"
                                       widget="statinfo"
                                       string="Consultations"/>
                            </button>
                        </div>

                        <!-- PATIENT INFORMATION -->
                        <group>

                            <group string="Patient Information">
                                <field name="patient_id"
                                       readonly="status in ['confirmed', 'cancel', 'no_show']"
                                       options="{'no_open': True, 'no_create': True}"
                                       required="1"/>
                                <field name="patient_gender" readonly="1"/>
                                <field name="patient_phone" readonly="1"/>
                                <field name="patient_email" readonly="1"/>
                            </group>

                            <!-- DOCTOR INFORMATION -->
                            <group string="Doctor Information">
                                <field name="doctor_id"
                                       readonly="status in ['confirmed', 'cancel', 'no_show']"
                                       options="{'no_open': True, 'no_create': True}"
                                       required="1"/>
                                <field name="doctor_fees" readonly="1"/>
                                <field name="doctor_speciality" readonly="1"/>
                                <field name="doctor_phone" readonly="1"/>
                                <field name="doctor_email" readonly="1"/>

                            </group>
                            <!-- APPOINTMENT DETAILS -->
                            <group string="Appointment Details">
                                <field name="appointment_datetime"
                                       readonly="status in ['confirmed', 'cancel', 'no_show']"/>
                                <field name="notes"
                                       readonly="status in ['confirmed', 'cancel', 'no_show']"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_appointment_list" model="ir.ui.view">
            <field name="name">clinic.appointment.list</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="appointment_datetime"/>
                    <field name="status"/>
                    <field name="status" widget="badge"
                           decoration-info="status == 'draft'"
                           decoration-success="status == 'confirmed'"
                           decoration-danger="status == 'cancel'"
                    />

                </list>
            </field>
        </record>

        <record id="view_appointment_kanban" model="ir.ui.view">
            <field name="name">clinic.appointment.kanban</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <kanban
                        decoration-success="status == 'confirmed'"
                        decoration-danger="status == 'cancel'"
                        decoration-warning="status == 'no_show'"
                        decoration-info="status == 'done'"
                        decoration-muted="status == 'draft'">

                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="appointment_datetime"/>
                    <field name="status"/>

                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card p-3 #{
                        record.status.raw_value == 'confirmed' and 'bg-success-subtle' or
                        record.status.raw_value == 'cancel' and 'bg-danger-subtle' or
                        record.status.raw_value == 'no_show' and 'bg-warning-subtle' or
                        record.status.raw_value == 'done' and 'bg-info-subtle' or
                        'bg-light'
                    }">

                                <div class="fw-bold fs-5 mb-1">
                                    <field name="patient_id"/>
                                </div>

                                <div class="text-muted mb-1">
                                    <i class="fa fa-user-md me-1" title="Doctor"/>
                                    <field name="doctor_id"/>
                                </div>

                                <div class="text-muted mb-2">
                                    <i class="fa fa-calendar me-1" title="Appointment Date"/>
                                    <field name="appointment_datetime"/>
                                </div>

                                <div>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'confirmed'"
                                           decoration-danger="status == 'cancel'"
                                           decoration-warning="status == 'no_show'"
                                           decoration-info="status == 'done'"
                                           decoration-secondary="status == 'draft'"/>
                                </div>

                            </div>
                        </t>
                    </templates>

                </kanban>
            </field>
        </record>

        <record id="view_appointment_calendar" model="ir.ui.view">
            <field name="name">clinic.appointment.calendar</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <calendar string="Appointments"
                          date_start="appointment_datetime"
                          color="doctor_id">

                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="status"/>
                </calendar>
            </field>
        </record>
        <!--Pivot View-->
        <record id="view_clinic_appointment_pivot" model="ir.ui.view">
            <field name="name">clinic.appointment.pivot</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <pivot string="Appointment Analysis">
                    <field name="patient_id" type="row"/>
                    <field name="doctor_id" type="row"/>
                    <field name="appointment_datetime" type="row"/>
                    <field name="status" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="view_appointment_graph" model="ir.ui.view">
            <field name="name">clinic.appointment.graph</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <graph string="Appointments Graph" type="bar">
                    <field name="doctor_id"/>
                </graph>
            </field>
        </record>
        <record id="view_clinic_appointment_search" model="ir.ui.view">
            <field name="name">clinic.appointment.search</field>
            <field name="model">clinic.appointment</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="filter_draft"
                            string="Draft"
                            domain="[('status','=','draft')]"/>

                    <filter name="filter_confirmed"
                            string="Confirmed"
                            domain="[('status','=','confirmed')]"/>

                    <filter name="filter_done"
                            string="Done"
                            domain="[('status','=','done')]"/>

                    <filter name="filter_no_show"
                            string="No Show"
                            domain="[('status','=','no_show')]"/>

                    <separator/>

                    <!-- Group By -->
                    <group>
                        <filter name="group_by_status"
                                string="Status"
                                context="{'group_by':'status'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_patient_id"
                                string="Patient"
                                context="{'group_by':'patient_id'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_doctor_id"
                                string="Doctor"
                                context="{'group_by':'doctor_id'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_appointment_code"
                                string="Code"
                                context="{'group_by':'appointment_code'}"/>
                    </group>

                </search>
            </field>
        </record>


        <record id="action_appointment" model="ir.actions.act_window">
            <field name="name">Appointments</field>
            <field name="res_model">clinic.appointment</field>
            <field name="view_mode">list,form,search,kanban,pivot,calendar,graph</field>
        </record>


    </data>
</odoo>