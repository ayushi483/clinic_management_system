<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Student List View -->
        <record id="view_clinic_patient_list" model="ir.ui.view">
            <field name="name">clinic.patient.list</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <list>
                    <field name="patient_code"/>
                    <field name="name"/>
                    <field name="gender"/>
                    <field name="age"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="address"/>
                    <!--     <field name="course_id"/>-->
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'confirmed'"
                    />

                </list>
            </field>
        </record>

        <!-- Student Form View -->
        <record id="view_clinic_patient_form" model="ir.ui.view">
            <field name="name">clinic.patient.form</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirm"/>

                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"
                        />
                    </header>
                    <sheet>
                        <div style="display: flex; align-items: center; justify-content: space-between;">

                            <div class="oe_title">
                                <label for="patient_code" string="Patient ID"/>
                                <h1>
                                    <field name="patient_code"
                                           placeholder="Auto-generated on save..."
                                           readonly="1"/>
                                </h1>
                            </div>

                            <!-- Right: Image -->
                            <field name="image_1920"
                                   widget="image"
                                   class="oe_avatar"
                                   style="width: 100px; height: 100px;"/>

                        </div>

                        <group>
                            <group string=" Basic Information">
                                <field name="name"/>
                                <field name="gender"/>
                                <field name="date_of_birth"/>
                                <field name="age"/>
                            </group>

                            <group string="Contact Details">
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medical History">
                                <field name="confirmed_appointment_ids" readonly="1">
                                    <list editable="bottom">
                                        <field name="doctor_id"/>
                                        <field name="appointment_datetime"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <!--Student Search View-->
        <record id="view_clinic_patient_search" model="ir.ui.view">
            <field name="name">clinic.patient.search</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="patient_code"/>

                    <separator/>


                    <filter name="filter_draft"
                            string="Draft"
                            domain="[('state','=','draft')]"/>

                    <filter name="filter_confirm"
                            string="Confirmed"
                            domain="[('state','=','confirm')]"/>

                    <separator/>
                    <separator/>

                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="active" domain="[('active','=',False)]"/>


                    <!-- Group By -->
                    <group>
                        <filter name="group_by_state"
                                string="State"
                                context="{'group_by':'state'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_name"
                                string="Name"
                                context="{'group_by':'name'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_age"
                                string="age"
                                context="{'group_by':'age'}"/>
                    </group>

                    <separator/>
                    <!-- Group By -->
                    <group>
                        <filter name="group_by_patient_code"
                                string="Student Code"
                                context="{'group_by':'patient_code'}"/>
                    </group>

                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_clinic_patient_kanban" model="ir.ui.view">
            <field name="name">clinic.patient.kanban</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="patient_code"/>
                    <!--                    <field name="course_id"/>-->
                    <!--                    <field name="class_id"/>-->

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Code:
                                    <field name="patient_code"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_clinic_patient_graph" model="ir.ui.view">
            <field name="name">clinic.patient.graph</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <graph>
                    <!--                    <field name="course_id" type="row"/>-->
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_clinic_patient_pivot" model="ir.ui.view">
            <field name="name">clinic.patient.pivot</field>
            <field name="model">clinic.patient</field>
            <field name="arch" type="xml">
                <pivot string="Patient Analysis">
                    <field name="name" type="row"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <field name="address" type="row"/>
                    <field name="gender" type="row"/>
                    <field name="email" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="action_clinic_patient" model="ir.actions.act_window">
            <field name="name">Patient</field>
            <field name="res_model">clinic.patient</field>
            <field name="view_mode">list,form,search,pivot,kanban,graph</field>
        </record>

    </data>
</odoo>