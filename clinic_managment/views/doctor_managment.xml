<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_doctor_form" model="ir.ui.view">
            <field name="name">clinic.doctor.form</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <form string="Doctor">
                    <sheet>
                         <div style="display: flex; align-items: center; justify-content: space-between;">

                            <field name="image_1024" widget="image" class="oe_avatar" style="width: 100px; height: 100px;"/>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="speciality_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="fees"/>
                            <field name="is_available"/>
                            <field name="total_appointment"/>
                        </group>
                        <notebook>
                            <page string="Availability">
                                <field name="availability_ids">
                                    <list editable="bottom">
                                        <field name="day"/>
                                        <field name="start_time" widget="float_time"/>
                                        <field name="end_time" widget="float_time"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_doctor_list" model="ir.ui.view">
            <field name="name">clinic.doctor.list</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="fees"/>
                    <field name="is_available"/>
                </list>
            </field>
        </record>

        <!-- KANBAN VIEW -->
        <record id="view_doctor_kanban" model="ir.ui.view">
            <field name="name">clinic.doctor.kanban</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="fees"/>
                    <field name="is_available"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <span>Fees:
                                    <field name="fees"/>
                                </span>
                                <br/>
                                <span>
                                    Status:
                                    <t t-if="record.is_available.raw_value">
                                        Available
                                    </t>
                                    <t t-else="">
                                        Not Available
                                    </t>
                                </span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- PIVOT VIEW -->
        <record id="view_clinic_doctor_pivot" model="ir.ui.view">
            <field name="name">clinic.doctor.pivot</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <pivot string="Doctor Analysis">
                    <field name="name" type="row"/>
                    <field name="phone" type="row"/>
                    <field name="email" type="row"/>
                    <field name="fees" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_clinic_doctor_search" model="ir.ui.view">
            <field name="name">clinic.doctor.search</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="fees"/>
                    <separator/>
                    <group>
                        <filter name="group_by_name" string="Name" context="{'group_by':'name'}"/>
                    </group>
                    <separator/>
                    <group>
                        <filter name="group_by_phone" string="Phone Number" context="{'group_by':'phone'}"/>
                    </group>
                    <separator/>
                    <group>
                        <filter name="group_by_email" string="Email" context="{'group_by':'email'}"/>
                    </group>
                    <separator/>
                    <group>
                        <filter name="group_by_fees" string="Fees" context="{'group_by':'fees'}"/>
                    </group>
                    <separator/>
                    <group>
                        <filter name="group_by_speciality_id" string="Speciality"
                                context="{'group_by':'speciality_id'}"/>
                    </group>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- GRAPH VIEW -->
        <record id="view_doctor_graph" model="ir.ui.view">
            <field name="name">clinic.doctor.graph</field>
            <field name="model">clinic.doctor</field>
            <field name="arch" type="xml">
                <graph string="Doctors Graph" type="bar">
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_doctor" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="res_model">clinic.doctor</field>
            <field name="view_mode">list,form,kanban,search,pivot,graph</field>
        </record>

    </data>
</odoo>